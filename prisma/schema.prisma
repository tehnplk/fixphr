generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hospital {
  hospcode      String  @id @db.VarChar(10)
  hospname      String  @db.VarChar(255)
  hospnameShort String? @map("hospname_short") @db.VarChar(255)
  hostype       String? @db.VarChar(20)
  address       String? @db.Text
  road          String? @db.Text
  mu            String? @db.VarChar(20)
  subdistcode   String? @db.VarChar(20)
  distcode      String? @db.VarChar(20)
  provcode      String? @db.VarChar(20)
  postcode      String? @db.VarChar(20)
  hoscodenew    String? @db.VarChar(20)
  bed           String? @db.VarChar(20)
  levelService  String? @map("level_service") @db.VarChar(50)
  bedhos        String? @db.VarChar(20)
  hdcRegist     String? @map("hdc_regist") @db.VarChar(20)
  dep           String? @db.VarChar(20)
  hmainSent     String? @map("hmain_sent") @db.VarChar(20)
  registerDate  String? @map("register_date") @db.VarChar(30)
  mcode         String? @db.VarChar(20)
  status        String? @db.VarChar(20)
  mName         String? @map("m_name") @db.VarChar(255)
  depName       String? @map("dep_name") @db.VarChar(255)
  zoneCode      String? @map("zone_code") @db.VarChar(20)
  zoneName      String? @map("zone_name") @db.VarChar(255)
  chwCode       String? @map("chw_code") @db.VarChar(20)
  chwName       String? @map("chw_name") @db.VarChar(255)
  ampCode       String? @map("amp_code") @db.VarChar(20)
  ampName       String? @map("amp_name") @db.VarChar(255)
  tmbCode       String? @map("tmb_code") @db.VarChar(20)
  tmbName       String? @map("tmb_name") @db.VarChar(255)
  bedCmi        String? @map("bed_cmi") @db.VarChar(20)
  note          String? @db.Text
  hostypeNew    String? @map("hostype_new") @db.VarChar(20)
  closeDate     String? @map("close_date") @db.VarChar(30)
  isActive      String? @map("is_active") @db.VarChar(20)

  @@index([hospname])
  @@index([provcode, distcode])
  @@map("hospitals")
}

model ComplaintHosCount {
  province_name  String   @db.VarChar(100)
  district_name  String   @db.VarChar(100)
  hospital_code  String   @db.VarChar(10)
  hospital_name  String   @db.VarChar(255)
  hospital_type  String   @db.VarChar(100)
  file_name      String   @db.VarChar(255)
  masks          Int
  citizens       Int
  matched        Int
  unmatched      Int
  match_rate_pct Decimal  @db.Decimal(5, 1)
  date_up        DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  time_up        DateTime @default(dbgenerated("LOCALTIME(0)")) @db.Time(0)

  @@id([date_up, time_up, hospital_code])
}

model Report {
  hospital_code     String   @db.VarChar(10)
  item_no           Int
  hn                String?  @db.Text
  vstdate           String?  @db.VarChar(20)
  issue             String?  @db.Text
  inspection_result String?  @db.Text
  note              String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  created_by        String?  @db.VarChar(100)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by        String?  @db.VarChar(100)

  @@id([hospital_code, item_no])
  @@map("report")
}

model UserProvider {
  id           Int       @id @default(autoincrement())
  provider_id  String    @unique @db.VarChar(64)
  cid_hash     String?   @db.VarChar(64)
  fullname     String?   @db.VarChar(255)
  hoscode      String?   @db.VarChar(10)
  hname        String?   @db.VarChar(255)
  role         String    @default("guest") @db.VarChar(20)
  login_count  Int       @default(0)
  last_activity DateTime? @db.Timestamptz(3)
  is_active    Boolean   @default(true)
  profile      Json?
  created_at   DateTime  @default(now()) @db.Timestamptz(3)

  @@map("user_provider")
}
